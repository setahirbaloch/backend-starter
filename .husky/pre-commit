#!/usr/bin/env bash

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

echo ""
echo -e "${CYAN}╭──────────────────────────────────────────────╮${RESET}"
echo -e "${CYAN}│${RESET}  🚀 ${BOLD}Starting lint-staged...${RESET}                       ${CYAN}│${RESET}"
echo -e "${CYAN}╰──────────────────────────────────────────────╯${RESET}"
echo ""

# Run lint-staged
if lint-staged; then
  echo ""
  echo -e "${GREEN}✨ All staged files passed linting!${RESET}"
  echo -e "${GREEN}✅ lint-staged completed successfully.${RESET}"
  echo ""
else
  echo ""
  echo -e "${YELLOW}⚠️  lint-staged found issues or failed.${RESET}"
  echo -e "${YELLOW}🛑 Commit aborted to maintain code quality.${RESET}"
  echo ""
  exit 1
fi