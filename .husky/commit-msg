#!/usr/bin/env bash
# .husky/commit-msg
# Purpose: Validate commit messages using commitlint with clear UI ✨

# ────────────────────────────────────────────────
# 🎨 Colors
# ────────────────────────────────────────────────
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

# ────────────────────────────────────────────────
# 🧾 Read commit message
# ────────────────────────────────────────────────
COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE" | head -n1)
COMMIT_TYPE=$(echo "$COMMIT_MSG" | grep -Eo '^[a-z]+' || echo "unknown")

echo ""
echo -e "${CYAN}╭────────────────────────────────────────────────────╮${RESET}"
echo -e "${CYAN}│${RESET}  📝 ${BOLD}Validating your commit message...${RESET}                     ${CYAN}│${RESET}"
echo -e "${CYAN}╰────────────────────────────────────────────────────╯${RESET}"
echo ""

# ────────────────────────────────────────────────
# 🧠 Run commitlint validation
# ────────────────────────────────────────────────
if npx --no -- commitlint --edit "$COMMIT_MSG_FILE"; then
  echo ""
  echo -e "${GREEN}✅ Commit message passed linting!${RESET}"
  echo -e "${GREEN}✨ Great job following Conventional Commits.${RESET}"
  echo ""

  if [[ "$COMMIT_TYPE" != "unknown" ]]; then
    echo -e "${YELLOW}🔍 Detected commit type:${RESET} ${BOLD}${COMMIT_TYPE}${RESET}"
  fi

  echo ""
  echo -e "${CYAN}Keep commits small, clear, and meaningful!${RESET}"
  echo ""
  exit 0
else
  echo ""
  echo -e "${RED}❌ Commit message validation failed.${RESET}"
  echo -e "${RED}🚫 Please follow the Conventional Commits format.${RESET}"
  echo ""

  echo -e "${BOLD}Examples (Write useful and descriptive commit message):${RESET}"
  echo ""
  echo -e "  ${CYAN}feat:${RESET} add new user registration endpoint"
  echo -e "  ${CYAN}fix:${RESET} resolve CORS issue in API middleware"
  echo -e "  ${CYAN}docs:${RESET} update README with API usage examples"
  echo -e "  ${CYAN}style:${RESET} format code with Biome and Prettier"
  echo -e "  ${CYAN}refactor:${RESET} simplify database query structure"
  echo -e "  ${CYAN}test:${RESET} add unit tests for user controller"
  echo -e "  ${CYAN}chore:${RESET} update dependencies and Husky hooks"
  echo -e "  ${CYAN}revert:${RESET} revert previous authentication fix"
  echo -e "  ${CYAN}perf:${RESET} improve caching performance"
  echo -e "  ${CYAN}ci:${RESET} update GitHub Actions pipeline config"
  echo -e "  ${CYAN}build:${RESET} configure production webpack settings"
  echo ""
  echo -e "${YELLOW}💡 Tip:${RESET} Use short, descriptive messages (max 100 chars)."
  echo ""
  echo -e "${CYAN}📘 For full commit rules and examples, see:${RESET} ${BOLD}./COMMIT_CONVENTION.md${RESET}"
  echo ""
  exit 1
fi