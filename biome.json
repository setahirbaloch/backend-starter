{
   "$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
   "vcs": {
      "enabled": false,
      "clientKind": "git",
      "useIgnoreFile": true
   },
   "files": {
      "ignoreUnknown": false,
      "includes": [
         "src/**/*",
         "scripts/**",
         "tests/**",
         "!**/node_modules",
         "!**/dist",
         "!**/build",
         "!**/husky",
         "!**/.vscode",
         "!**/*.log"
      ]
   },
   "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 3,
      "formatWithErrors": true
   },
   "linter": {
      "enabled": true,
      "rules": {
         "recommended": true,
         "correctness": {
            "noUnusedVariables": "error",
            "noUnusedImports": "error"
         },
         "suspicious": {
            "noExplicitAny": "off"
         },
         "a11y": {
            "recommended": false
         }
      }
   },
   "javascript": {
      "formatter": {
         "quoteStyle": "single",
         "semicolons": "asNeeded",
         "trailingCommas": "es5"
      }
   },
   "assist": {
      "actions": {
         "source": {
            "organizeImports": "on"
         }
      }
   }
}
